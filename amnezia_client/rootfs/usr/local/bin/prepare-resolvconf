#!/usr/bin/env bash
set -euo pipefail

config="${1:-}"
resolv_conf="${RESOLV_CONF:-/etc/resolv.conf}"
snapshot="${RESOLVCONF_SNAPSHOT:-/run/amneziawg/resolv.conf.system}"
resolvconf_command="${RESOLVCONF_COMMAND:-resolvconf}"

if [[ -z "${config}" || ! -f "${config}" ]]; then
    echo "AmneziaWG configuration file is missing" >&2
    exit 1
fi

if ! grep -Eq '^[[:space:]]*DNS[[:space:]]*=' "${config}"; then
    exit 0
fi

if [[ "$(head -n 1 "${resolv_conf}" 2>/dev/null || true)" == "# Generated by resolvconf" ]]; then
    exit 0
fi

# openresolv refuses a resolv.conf it did not generate. Keep the Supervisor
# supplied DNS configuration as the base that is restored when awg0 goes down.
cp "${resolv_conf}" "${snapshot}"
"${resolvconf_command}" -u
"${resolvconf_command}" -a system < "${snapshot}"
